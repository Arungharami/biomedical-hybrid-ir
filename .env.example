# Copy this file to .env and fill in real values. Never commit .env itself.

# Optional: Hugging Face access token (only needed for gated models/datasets;
# BeIR/nfcorpus, BAAI/bge-base-en-v1.5 and ncbi/MedCPT-* are public and do not require one)
HUGGINGFACE_TOKEN=

# Cache locations (override the defaults in configs/default.yaml if desired)
HF_HOME=./data/cache/huggingface
TRANSFORMERS_CACHE=./data/cache/huggingface

# Device override: cuda | mps | cpu | auto
BIOMEDICAL_IR_DEVICE=auto

# Random seed
BIOMEDICAL_IR_SEED=42

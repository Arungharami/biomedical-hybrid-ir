# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment / secrets
.env
*.env.local
.envrc

# Data - raw/cache is regenerable from Hugging Face, never commit
data/raw/*
data/cache/*
!data/raw/.gitkeep
!data/cache/.gitkeep

# Model weights / embeddings (regenerable; too large for git)
*.faiss
*.index
*.bin
*.pt
*.safetensors
models/
embeddings/
!results/**/*.json

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Next.js / Node
web/node_modules/
web/.next/
web/out/
web/.vercel/
web/*.tsbuildinfo
web/npm-debug.log*

# Logs
*.log
logs/
